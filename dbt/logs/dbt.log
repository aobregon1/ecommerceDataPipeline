    select * from ECOMMERCE_DATA_PIPELINE.stage.products
),

reviews as (
    select 
        order_id,
        avg(review_score) as avg_review_score_per_order
    from ECOMMERCE_DATA_PIPELINE.stage.order_reviews
    group by 1
)

